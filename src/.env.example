# Android release signing (optional). Copy to .env and set values. .env is gitignored.
#
# Path to the keystore file (absolute path recommended).
# RELEASE_STORE_FILE=/path/to/keystore.jks
#
# Optional: path to a text file containing the keystore/key password (one line).
# Used for both store and key when building release. Use chmod 600 and keep outside repo.
# ANDROID_KEY_PASSWORD_FILE=/path/to/password.txt
#
# Gitea release upload token (required by upload-gitea-release.py).
# GITEA_RELEASE_TOKEN=your_gitea_token
#
# Gitea release upload User-Agent header.
# GITEA_UPLOAD_USER_AGENT=Gitea-Cloudflare-Antibot-Bypass token1234

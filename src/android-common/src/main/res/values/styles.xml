<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base: filled button, no colors (recolor via layout or use a colored style below) -->
    <style name="gv_common_ButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Primary button: blue filled -->
    <style name="gv_common_ButtonPrimary" parent="gv_common_ButtonBase">
        <item name="android:textColor">@color/gv_common_content_on_primary</item>
        <item name="backgroundTint">@color/gv_common_primary_blue</item>
    </style>

    <!-- Base: outlined button, no colors (recolor via layout or use a colored style below) -->
    <style name="gv_common_ButtonOutlinedBase" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Outlined button: primary blue stroke and text -->
    <style name="gv_common_ButtonOutlined" parent="gv_common_ButtonOutlinedBase">
        <item name="android:textColor">@color/gv_common_primary_blue</item>
        <item name="strokeColor">@color/gv_common_primary_blue</item>
    </style>

    <!-- Outlined secondary: muted secondary text and stroke -->
    <style name="gv_common_ButtonSecondary" parent="gv_common_ButtonOutlinedBase">
        <item name="android:textColor">@color/gv_common_text_secondary</item>
        <item name="strokeColor">@color/gv_common_text_secondary</item>
    </style>

    <!-- Outlined destructive: red stroke and text (e.g. delete actions) -->
    <style name="gv_common_ButtonOutlinedDestructive" parent="gv_common_ButtonOutlinedBase">
        <item name="android:textColor">@color/gv_common_error_red</item>
        <item name="strokeColor">@color/gv_common_error_red</item>
    </style>

    <!-- Base: text button, no background/border (recolor via layout or use a colored style below) -->
    <style name="gv_common_ButtonTextBase" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Text button: primary blue text -->
    <style name="gv_common_ButtonText" parent="gv_common_ButtonTextBase">
        <item name="android:textColor">@color/gv_common_primary_blue</item>
    </style>

    <!-- Text button: secondary grey text (e.g. Cancel) -->
    <style name="gv_common_ButtonTextSecondary" parent="gv_common_ButtonTextBase">
        <item name="android:textColor">@color/gv_common_text_secondary</item>
    </style>

    <!-- Base: icon-only button (set icon and optional iconTint in layout) -->
    <style name="gv_common_ButtonIconBase" parent="Widget.MaterialComponents.Button.Icon">
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- EditText style for GeoVault-style input fields -->
    <style name="gv_common_EditText">
        <item name="android:background">@drawable/gv_common_edit_text_background</item>
        <item name="android:textColor">@color/gv_common_text_primary</item>
        <item name="android:textColorHint">@color/gv_common_text_secondary</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Alert dialog: confirmation (positive) button uses theme-aware color (blue in light, light grey in dark) -->
    <style name="gv_common_AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/gv_common_DialogPositiveButton</item>
    </style>
    <style name="gv_common_DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gv_common_dialog_positive_button</item>
    </style>

    <!-- Styled dropdown: Material ExposedDropdownMenu container (use with AutoCompleteTextView inside) -->
    <style name="gv_common_ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/gv_common_text_secondary</item>
    </style>

    <!-- Inner AutoCompleteTextView for gv_common_ExposedDropdownMenu (no keyboard, themed text/background) -->
    <style name="gv_common_AutoCompleteDropdown" parent="Widget.MaterialComponents.AutoCompleteTextView.FilledBox">
        <item name="android:inputType">none</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:textColor">@color/gv_common_text_primary</item>
        <item name="android:textColorHint">@color/gv_common_text_secondary</item>
        <item name="android:background">@drawable/gv_common_edit_text_background</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="gv_common_MaterialCardView_NoShadow" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
    </style>

    <style name="gv_common_CardView_NoShadow" parent="CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
    </style>

    <style name="gv_common_FloatingActionButton_NoShadow" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
    </style>

    <!-- Section header (blue bar with title) -->
    <style name="gv_common_SectionHeader">
        <item name="android:background">@color/gv_common_primary_blue</item>
        <item name="android:textColor">@color/gv_common_content_on_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal XML projection of `GeoVaultColorTokens` (Kotlin is the source of truth).

    Only names actually consumed by the Android framework or by declarative
    drawables/layouts live here. Everything else (full scale, dark mode tokens,
    hex projections, semantic + cross-app tokens) is defined in Kotlin.

    Each name below is locked to a Kotlin token by `GeoVaultColorTokensXmlSyncTest`,
    which fails CI on any drift in either direction.

    Active consumers per name:
      - gv_common_main_blue: splash theme; user-location puck arrow drawable
        (light + night); default marker drawable.
      - gv_common_main_yellow: selected marker drawable.
      - gv_common_surface: popup notch / card / divider backgrounds.
      - gv_common_border_light: popup notch / card / divider strokes.
      - gv_common_text_primary: overlapping-point row text.
      - gv_common_text_secondary: chevron-down icon tint.
      - gv_common_map_heading_north: heading/rotation FAB compass north segment.
-->
<resources>
    <color name="gv_common_main_blue">#163D8A</color>
    <color name="gv_common_main_yellow">#F4AC45</color>
    <color name="gv_common_surface">#FFFFFF</color>
    <color name="gv_common_border_light">#C4D2ED</color>
    <color name="gv_common_text_primary">#061D4A</color>
    <color name="gv_common_text_secondary">#4B5563</color>
    <color name="gv_common_map_heading_north">#FF3E41</color>
</resources>

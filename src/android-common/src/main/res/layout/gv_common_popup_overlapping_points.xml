<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gv_common_popup_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/gv_common_surface"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/gv_common_border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ListView
            android:id="@+id/gv_common_popup_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/gv_common_overlapping_popup_max_height"
            android:divider="@color/gv_common_border_light"
            android:dividerHeight="1dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical" />

        <ImageView
            android:id="@+id/gv_common_popup_chevron"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/gv_common_ic_chevron_down"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

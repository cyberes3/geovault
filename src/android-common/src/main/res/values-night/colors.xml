<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-mode overrides for the names in `values/colors.xml` that flip in night mode.

    Brand colors (`gv_common_main_blue`, `gv_common_main_yellow`) intentionally do
    not appear here — they stay branded across both themes.

    Each name below is locked to `GeoVaultColorTokens.Dark.*` by
    `GeoVaultColorTokensXmlSyncTest`, which fails CI on any drift.
-->
<resources>
    <color name="gv_common_surface">#111827</color>
    <color name="gv_common_border_light">#374151</color>
    <color name="gv_common_text_primary">#E5E7EB</color>
    <color name="gv_common_text_secondary">#BFC8D6</color>
</resources>

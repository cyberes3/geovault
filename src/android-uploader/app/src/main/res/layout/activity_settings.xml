<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/list_background">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/list_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:background="@color/primary_blue"
            android:elevation="0dp"
            android:minHeight="64dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/content_on_primary" />

        </LinearLayout>

        <!-- Settings Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- Server URL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/server_url_hint"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/serverUrlEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="geovault.example.com"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:background="@drawable/edit_text_background"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:layout_marginBottom="24dp"
                    android:minHeight="56dp" />

                <!-- Connect / Disconnect -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectButton"
                    style="@style/gv_common_ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/connect_account"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnectButton"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/disconnect"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loggedInUserText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logged in as..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:visibility="invisible" />

                <!-- Add Suffix Checkbox -->
                <CheckBox
                    android:id="@+id/addSuffixCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_suffix_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp"
                    app:buttonTint="@color/primary_blue" />

                <!-- Help Text -->
                <TextView
                    android:id="@+id/settingsHelpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_help_text"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="8dp" />

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/gv_common_ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/save_settings"
                    android:textColor="@color/content_on_primary"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


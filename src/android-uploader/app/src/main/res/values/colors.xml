<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary colors: reference android-common for single source of truth -->
    <color name="primary_blue">@color/gv_common_primary_blue</color>
    <color name="primary_blue_dark">@color/gv_common_primary_blue_dark</color>
    <color name="blue_light">@color/gv_common_blue_light</color>
    <color name="blue_extra_light">@color/gv_common_blue_extra_light</color>

    <!-- Text colors -->
    <color name="text_primary">@color/gv_common_text_primary</color>
    <color name="text_secondary">@color/gv_common_text_secondary</color>

    <!-- Status colors -->
    <color name="success_green">@color/gv_common_success_green</color>
    <color name="error_red">@color/gv_common_error_red</color>
    <color name="warning_yellow">@color/gv_common_warning_yellow</color>

    <!-- Basic colors -->
    <color name="white">@color/gv_common_white</color>
    <color name="black">@color/gv_common_black</color>
    <color name="surface">@color/gv_common_surface</color>
    <color name="content_on_primary">@color/gv_common_content_on_primary</color>
    <color name="border_light">@color/gv_common_border_light</color>

    <!-- Error state (for error_background drawable) -->
    <color name="error_light">@color/gv_common_error_light</color>
    <color name="error_stroke">@color/gv_common_error_stroke</color>

    <!-- List/container background (same as container in day; pure black in night) -->
    <color name="list_background">@color/blue_extra_light</color>

    <!-- Legacy colors (reference gray scale) -->
    <color name="gray">@color/gv_common_gray_500</color>
    <color name="gray_light">@color/gv_common_gray_100</color>
    <color name="gray_600">@color/gv_common_text_secondary</color>
</resources>

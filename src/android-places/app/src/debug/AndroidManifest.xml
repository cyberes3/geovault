<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App-specific permission so all 4 apps (places/uploader × release/debug) install without INSTALL_FAILED_DUPLICATE_PERMISSION. Prefill is release-only. -->
    <permission
        android:name="com.geovault.common.permission.READ_SERVER_URL"
        tools:node="remove" />
    <uses-permission
        android:name="com.geovault.common.permission.READ_SERVER_URL"
        tools:node="remove" />
    <permission
        android:name="com.geovault.places.permission.READ_SERVER_URL_DEBUG"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.geovault.places.permission.READ_SERVER_URL_DEBUG" />

    <application>
        <provider
            android:name="com.geovault.common.ServerUrlProvider"
            android:authorities="${applicationId}.serverurl"
            android:exported="true"
            android:permission="com.geovault.places.permission.READ_SERVER_URL_DEBUG"
            tools:replace="android:permission" />
        <activity
            android:name=".OAuthCallbackActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.geovault.places.debug" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>

# Optional env for tests that need external services (areas server DB, etc.).
# Copy to .env and set values as needed. .env is gitignored.
#
# Areas server Postgres (for tests that check waterways.major_waterways, etc.)
# AREAS_SERVER_DATABASE=postgresql://user:pass@host/dbname

# Path to the geovault-tests corpus repo, if not symlinked at
# tests/files/geovault-tests (see tests/README.md).
# GEOVAULT_TESTS_DIR=/path/to/geovault-tests

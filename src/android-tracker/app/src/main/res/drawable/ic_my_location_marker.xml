<?xml version="1.0" encoding="utf-8"?>
<!-- Blue circle with white outer border and thin black outer border for GPS location. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">
    <!-- Thin black outer ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/black"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 16,3.5 A 12.5,12.5 0 0,1 28.5,16 A 12.5,12.5 0 0,1 16,28.5 A 12.5,12.5 0 0,1 3.5,16 A 12.5,12.5 0 0,1 16,3.5 Z" />
    <!-- White outer border -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 16,5 A 11,11 0 0,1 27,16 A 11,11 0 0,1 16,27 A 11,11 0 0,1 5,16 A 11,11 0 0,1 16,5 Z" />
    <!-- Blue center -->
    <path
        android:fillColor="@color/primary_blue"
        android:pathData="M 16,16 m -10,0 a 10,10 0 1,1 20,0 a 10,10 0 1,1 -20,0 Z" />
</vector>

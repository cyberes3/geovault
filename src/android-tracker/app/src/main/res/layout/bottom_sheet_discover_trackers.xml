<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:minHeight="200dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_tracker"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/discoverScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/discoverPublicHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/discover_public"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/discoverPublicList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/discoverSharedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/discover_shared_with_me"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/discoverSharedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/discoverPublicGroupsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Public groups"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:id="@+id/discoverPublicGroupsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/discoverSharedGroupsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shared with you (groups)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:id="@+id/discoverSharedGroupsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/discoverLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <com.geovault.common.LoadingSpinner
                android:id="@+id/discoverSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/discoverEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/discover_empty"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_extra_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:background="@color/primary_blue"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_tracker_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/content_on_primary" />
        </LinearLayout>

        <!-- Guest content: server URL + Connect at top (same as Settings in other apps) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_url_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/guestServerUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="geovault.example.com"
                android:inputType="textUri"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guestConnectButton"
                style="@style/gv_common_ButtonConnectAccount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/connect_account" />
        </LinearLayout>
    </LinearLayout>

    <!-- Important message bar from common -->
    <com.geovault.common.ImportantMessageSnackbar
        android:id="@+id/importantMessageSnackbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_tracker_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <ImageButton
            android:id="@+id/editTrackerClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/editTrackerScrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />
            <android.widget.EditText
                android:id="@+id/editTrackerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:minHeight="56dp"
                android:layout_marginBottom="16dp"
                android:hint="Tracker name" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.5" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/colorPreview"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_color_chip"
                        android:layout_marginEnd="12dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickColorButton"
                        style="@style/gv_common_ButtonOutlined"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/pick_color" />
                    <android.widget.EditText
                        android:id="@+id/editTrackerColor"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:background="@drawable/edit_text_background"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/default_tracker_color"
                        android:hint="@string/default_tracker_color_hex" />
                </LinearLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/default_track_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/editTrackerDefaultSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hide_on_map"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/editTrackerHideOnMapSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_recent_data"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/gv_common_ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <AutoCompleteTextView
                    android:id="@+id/editTrackerRecentDataSpinner"
                    style="@style/gv_common_AutoCompleteDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:hint="@string/show_recent_data" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/editTrackerSharingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sharing_section"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/visibility_label"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/gv_common_ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <AutoCompleteTextView
                        android:id="@+id/editTrackerVisibilitySpinner"
                        style="@style/gv_common_AutoCompleteDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="@string/visibility_label" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/editTrackerSharedWithContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shared_with_recipients_label"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp" />
                    <LinearLayout
                        android:id="@+id/editTrackerRecipientsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editTrackerAddRecipient"
                        style="@style/gv_common_ButtonOutlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/add_recipient"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/share_params_with_recipients_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/editTrackerShareParamsRecipients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allow_adding_to_groups_label"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/editTrackerAllowGroupReshare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/allow_adding_to_groups_warning"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/world_share_enabled_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/editTrackerWorldShareEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editTrackerWorldShareParamsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/share_params_with_world_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/editTrackerShareParamsWorld"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editTrackerCopyWorldLink"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/copy_world_share_link"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editTrackerOwnerToolsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_tools"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editTrackerExportKml"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/export_kml"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editTrackerClearHistory"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/clear_history_tracker"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/editTrackerDelete"
                style="@style/gv_common_ButtonOutlinedDestructive"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/delete_tracker"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/editTrackerLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <com.geovault.common.LoadingSpinner
                    android:id="@+id/editTrackerLoadingSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/loading_params"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/surface"
        android:gravity="end">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/editTrackerSave"
            style="@style/gv_common_ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>

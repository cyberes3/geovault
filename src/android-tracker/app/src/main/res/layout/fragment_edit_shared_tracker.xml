<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_shared_tracker_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/editSharedTrackerClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/editSharedTrackerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/editSharedTrackerOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <com.geovault.common.ToggleHelpCardView
                    android:id="@+id/editSharedTrackerHideOnMapSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:toggleTitleText="@string/hide_on_map"
                    app:toggleHelpText="@string/hide_on_map_help_text"
                    android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                    android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editSharedTrackerUnsubscribe"
                    style="@style/gv_common_ButtonOutlinedDestructive"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/unsubscribe"
                    android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editSharedTrackerRemoveFromShare"
                    style="@style/gv_common_ButtonOutlinedDestructive"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/remove_from_share"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/editSharedTrackerLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <com.geovault.common.LoadingSpinner
                android:id="@+id/editSharedTrackerLoadingSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>

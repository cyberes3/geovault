<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Settings Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Toggle switches section (top) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/extendedParamsSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/extended_params_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/significantMotionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/significantMotionSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Only log if motion detected"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
            </FrameLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/startOnBootSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start tracking on boot"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/restartTrackingIfKilledSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/restart_tracking_if_killed_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/startTrackingOnLaunchSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/start_tracking_on_launch_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- HR between toggles and logging/filter -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Auto Tracking Toggle -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoTrackingSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/auto_tracking_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Tracking Profile Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tracking_profile_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/profileSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_spinner_selector"
                android:paddingStart="14dp"
                android:paddingEnd="40dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="24dp" />


            <!-- Logging / filter fields section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Logging Interval (seconds)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <ImageButton
                    android:id="@+id/loggingHelpButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/logging_help_button"
                    android:scaleType="centerInside"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <EditText
                android:id="@+id/intervalEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="15"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/distanceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="10"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <TextView
                android:id="@+id/accuracyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accuracy Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/accuracyEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="50"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- HR between logging/filter and connection details -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Connection details -->
            <!-- Server URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server URL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/serverUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="geovault.example.com"
                android:inputType="textUri"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Connect / Disconnect -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/gv_common_ButtonConnectAccount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/connect_account"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/disconnect"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loggedInUserText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logged in as..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:visibility="invisible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

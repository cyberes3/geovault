<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Settings Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Toggle switches section (top) -->
            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/extendedParamsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/extended_params_label"
                app:toggleHelpText="@string/extended_params_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/significantMotionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/significant_motion_label"
                app:toggleHelpText="@string/significant_motion_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical">
            </com.geovault.common.ToggleHelpCardView>

            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/startOnBootSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/start_on_boot_label"
                app:toggleHelpText="@string/start_on_boot_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/startTrackingOnLaunchSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/start_tracking_on_launch_label"
                app:toggleHelpText="@string/start_tracking_on_launch_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/keepScreenOnWhileViewingMapSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/keep_screen_on_while_viewing_map_label"
                app:toggleHelpText="@string/keep_screen_on_while_viewing_map_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hiddenTrackersButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/hidden_trackers"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewAllTrackersButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/show_all_trackers_in_settings"
                android:layout_marginBottom="16dp" />

            <!-- HR between toggles and logging/filter -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Auto Tracking Toggle -->
            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/autoTrackingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/auto_tracking_label"
                app:toggleHelpText="@string/auto_tracking_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <!-- Tracking Profile Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tracking_profile_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/gv_common_ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <AutoCompleteTextView
                    android:id="@+id/profileSpinner"
                    style="@style/gv_common_AutoCompleteDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:hint="@string/tracking_profile_label" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tracking_profile_help_text"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <!-- Logging / filter fields (with auto & profile section) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/logging_interval_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <ImageButton
                    android:id="@+id/loggingHelpButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/logging_help_button"
                    android:scaleType="centerInside"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <EditText
                android:id="@+id/intervalEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"
                android:minHeight="56dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logging_interval_help_text"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/distanceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"
                android:minHeight="56dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/distance_filter_help_text"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/accuracyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accuracy Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/accuracyEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:minHeight="56dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accuracy_filter_help_text"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tracking_settings_apply_after_restart"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- HR between auto/profile and low accuracy fallback -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Low Accuracy Fallback section -->
            <com.geovault.common.ToggleHelpCardView
                android:id="@+id/lowAccuracyFallbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toggleTitleText="@string/low_accuracy_fallback_label"
                app:toggleHelpText="@string/low_accuracy_fallback_help_text"
                android:layout_marginTop="@dimen/gv_common_toggle_help_card_margin_vertical"
                android:layout_marginBottom="@dimen/gv_common_toggle_help_card_margin_vertical" />

            <TextView
                android:id="@+id/lowAccuracyFallbackTimeoutLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/low_accuracy_fallback_timeout_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/lowAccuracyFallbackTimeoutEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:minHeight="56dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/low_accuracy_fallback_timeout_help_text"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- HR between low accuracy fallback and connection details -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Connection details -->
            <!-- Server URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_url_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/serverUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="geovault.example.com"
                android:inputType="textUri"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Connect / Disconnect -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/gv_common_ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/connect_account"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/disconnect"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loggedInUserText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logged in as..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:visibility="invisible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

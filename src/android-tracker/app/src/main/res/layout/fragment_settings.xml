<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Settings Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tracker Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/selectedTrackerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected Tracker"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <com.geovault.common.LoadingSpinner
                    android:id="@+id/trackerSaveProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:spinnerSize="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/trackerSelectorCard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/selectedTrackerText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/select_tracker"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="italic" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hidden spinner for actual data binding if needed, but we'll use a dialog -->
            <Spinner
                android:id="@+id/trackerSpinner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createTrackerButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Create New Tracker"
                android:layout_marginBottom="24dp" />

            <!-- Logging settings help -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Logging Interval (seconds)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <ImageButton
                    android:id="@+id/loggingHelpButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/logging_help_button"
                    android:scaleType="centerInside"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <EditText
                android:id="@+id/intervalEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="15"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Distance Filter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/distanceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="10"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Accuracy Filter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accuracy Filter (meters)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/accuracyEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="50"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Extended Parameters: off = GVLM minimal (position + time only) to minimize data usage -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/extendedParamsSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/extended_params_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Significant Motion -->
            <FrameLayout
                android:id="@+id/significantMotionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/significantMotionSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Only log if motion detected"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
            </FrameLayout>

            <!-- Start on Boot -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/startOnBootSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start tracking on boot"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Restart tracking if app killed -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/restartTrackingIfKilledSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/restart_tracking_if_killed_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Start tracking when app is launched -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/startTrackingOnLaunchSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/start_tracking_on_launch_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <!-- Server URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server URL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/serverUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="geovault.example.com"
                android:inputType="textUri"
                android:padding="14dp"
                android:background="@drawable/edit_text_background"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp" />

            <!-- Connect / Disconnect -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/gv_common_ButtonConnectAccount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/connect_account"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/disconnect"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loggedInUserText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logged in as..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:visibility="invisible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

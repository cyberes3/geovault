<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sharing_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sharing_section"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />
    <TextView
        android:id="@+id/sharing_visibility_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visibility_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sharing_visibility_layout"
        style="@style/gv_common_ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <AutoCompleteTextView
            android:id="@+id/sharing_visibility_spinner"
            style="@style/gv_common_AutoCompleteDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:hint="@string/visibility_label" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sharing_visibility_help_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sharing_visibility_help_text"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sharing_pick_users_button"
        style="@style/gv_common_ButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/pick_users_to_share_with"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/sharing_shared_with_count_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:minHeight="200dp">

    <EditText
        android:id="@+id/groupDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_group_name_hint"
        android:inputType="text"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:padding="10dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_tracks"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />
    <LinearLayout
        android:id="@+id/groupDetailTracksList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="6dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/groupDetailAddTrack"
        style="@style/gv_common_ButtonOutlined"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/add_track_to_group"
        android:layout_marginBottom="12dp" />

    <include
        layout="@layout/include_sharing_section"
        android:id="@+id/sharingSectionInclude" />
    <LinearLayout
        android:id="@+id/groupDetailWorldShareRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/groupDetailWorldShareSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/world_share_enabled_label"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailCopyWorldLink"
            style="@style/gv_common_ButtonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/copy_world_share_link"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupDetailHideInListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/groupDetailHideInListSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hide_in_list_label"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/groupDetailHideInListHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hide_in_list_hint"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailLeave"
            style="@style/gv_common_ButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/leave_group" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailDelete"
            style="@style/gv_common_ButtonOutlinedDestructive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/delete_group" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:minHeight="200dp">

    <EditText
        android:id="@+id/groupDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_group_name_hint"
        android:inputType="text"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:padding="12dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_tracks"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />
    <LinearLayout
        android:id="@+id/groupDetailTracksList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/groupDetailAddTrack"
        style="@style/gv_common_ButtonOutlined"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/add_track_to_group"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/groupDetailSharingSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sharing_section"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/groupDetailSharingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visibility_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <Spinner
        android:id="@+id/groupDetailVisibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/groupDetailSharedWithList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/groupDetailAddSharedWith"
        style="@style/gv_common_ButtonOutlined"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/shared_with_recipients_label"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/groupDetailWorldShareRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/groupDetailWorldShareSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/world_share_enabled_label"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailCopyWorldLink"
            style="@style/gv_common_ButtonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/copy_world_share_link"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailLeave"
            style="@style/gv_common_ButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/leave_group" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupDetailDelete"
            style="@style/gv_common_ButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/delete_group"
            app:backgroundTint="@color/error_red" />
    </LinearLayout>
</LinearLayout>

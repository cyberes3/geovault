<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:minHeight="200dp">

    <EditText
        android:id="@+id/groupDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_group_name_hint"
        android:inputType="text|textCapWords"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:padding="10dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/groupDetailTracksRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/groupDetailTracksCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <include
        layout="@layout/include_sharing_section"
        android:id="@+id/sharingSectionInclude" />
    <LinearLayout
        android:id="@+id/groupDetailWorldShareRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/groupDetailWorldShareSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/world_share_enabled_label"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/groupDetailCopyWorldLink"
                style="@style/gv_common_ButtonOutlined"
                android:layout_width="192dp"
                android:layout_height="36dp"
                android:text="@string/copy_world_share_link"
                android:visibility="gone" />
            <com.geovault.common.LoadingSpinner
                android:id="@+id/groupDetailCopyWorldLinkSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:spinnerSize="24dp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupDetailHideInListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/groupDetailHideInListSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hide_in_list_label"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/groupDetailDelete"
        style="@style/gv_common_ButtonOutlinedDestructive"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/delete_group" />
</LinearLayout>

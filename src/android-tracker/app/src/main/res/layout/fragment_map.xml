<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@+id/mapLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/map_loading_overlay_background"
        android:clickable="true"
        android:focusable="true">
        <com.geovault.common.LoadingSpinner
            android:id="@+id/mapLoadingSpinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            app:spinnerSize="36dp" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trackerLabelCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:minWidth="0dp"
        android:visibility="gone"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/trackerLabelIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                app:tint="@color/content_on_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/trackerNameLabel"
                app:layout_constraintBottom_toBottomOf="@+id/trackerNameLabel" />

            <TextView
                android:id="@+id/trackerNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                android:textColor="@color/content_on_primary"
                android:text="@string/select_tracker"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toEndOf="@+id/trackerLabelIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/resetToTrackerButton"
                app:layout_constraintHorizontal_bias="0.0"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/resetToTrackerButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/recenter_to_tracker"
                app:tint="@color/content_on_primary"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/trackerNameLabel"
                app:layout_constraintBottom_toBottomOf="@+id/trackerNameLabel" />

            <TextView
                android:id="@+id/lastUpdatedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                android:textSize="12sp"
                android:textColor="@color/content_on_primary"
                app:layout_constrainedWidth="true"
                app:layout_constraintTop_toBottomOf="@+id/trackerNameLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/zoomToLatestButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <ImageView
            android:id="@+id/zoomToLatestButtonIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_crosshair"
            android:contentDescription="@string/zoom_to_latest_description"
            app:tint="@color/content_on_primary"
            android:padding="10dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/showMyLocationButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/showMyLocationButtonIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_location_enabled"
                android:contentDescription="@string/show_my_location_description"
                app:tint="@color/content_on_primary"
                android:padding="10dp" />
            <com.geovault.common.LoadingSpinner
                android:id="@+id/showMyLocationButtonLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:spinnerSize="20dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_layers"
            android:contentDescription="@string/map_toggle_description"
            app:tint="@color/content_on_primary"
            android:padding="10dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/zoomInButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/zoom_in_description"
            app:tint="@color/content_on_primary"
            android:padding="10dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/zoomOutButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="220dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_remove"
            android:contentDescription="@string/zoom_out_description"
            app:tint="@color/content_on_primary"
            android:padding="10dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/liveActiveFitButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="268dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue">
        <ImageView
            android:id="@+id/liveActiveFitButtonIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_live_active_fit_off"
            android:contentDescription="@string/live_active_fit_enable"
            app:tint="@color/content_on_primary"
            android:padding="10dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapTrackerInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_map_tracker_info_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/mapTrackerInfoName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:maxLines="1" />
                <ImageView
                    android:id="@+id/mapTrackerInfoZoomLock"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_crosshair"
                    android:contentDescription="@string/zoom_and_lock_tracker"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/primary_blue" />
                <ImageView
                    android:id="@+id/mapTrackerInfoClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/close"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/primary_blue" />
            </LinearLayout>
            <TextView
                android:id="@+id/mapTrackerInfoCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/mapTrackerInfoLastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mapTrackerInfoFocus"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:contentDescription="@string/focus_tracker_on_map"
                    app:icon="@drawable/ic_focus_tracker"
                    app:iconTint="@color/primary_blue"
                    app:iconSize="22dp"
                    app:iconPadding="0dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mapTrackerInfoViewParams"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:contentDescription="@string/view_params"
                    app:icon="@drawable/ic_params"
                    app:iconTint="@color/primary_blue"
                    app:iconSize="22dp"
                    app:iconPadding="0dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mapTrackerInfoViewInList"
                    style="@style/gv_common_ButtonOutlined"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:contentDescription="@string/view_in_trackers_list"
                    app:icon="@drawable/ic_list_bullet"
                    app:iconTint="@color/primary_blue"
                    app:iconSize="22dp"
                    app:iconPadding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/bottomRightIndicatorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="0dp"
        android:visibility="gone">
        <com.geovault.common.LoadingSpinner
            android:id="@+id/geometryLoadingSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:spinnerSize="32dp" />
        <View
            android:id="@+id/streamingIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/gv_common_bg_red_circle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/gpsAccuracyWarningIndicator"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_satellite_warning"
            android:contentDescription="@string/map_gps_accuracy_warning_description"
            app:tint="@color/error_red"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>

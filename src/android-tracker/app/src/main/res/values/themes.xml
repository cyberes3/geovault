<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GeoVault" parent="gv_common_Theme.GeoVault">
        <item name="android:windowAnimationStyle">@style/Animation.NoAnimation</item>
    </style>

    <style name="Animation.NoAnimation" parent="android:Animation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="TextAppearance.TabBlue" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/primary_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gv_common_filter_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/gv_common_filter_chip_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/gv_common_chip_background"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:minHeight="@dimen/gv_common_filter_chip_height">

    <TextView
        android:id="@+id/gv_common_filter_chip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/gv_common_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/gv_common_filter_chip_close"
        android:layout_width="@dimen/gv_common_filter_chip_close_icon_size"
        android:layout_height="@dimen/gv_common_filter_chip_close_icon_size"
        android:src="@drawable/gv_common_ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gv_common_text_primary"
        android:contentDescription="@string/gv_common_close"
        android:scaleType="centerInside" />
</LinearLayout>

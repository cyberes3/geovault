<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <View
        android:id="@+id/gv_common_popup_notch_top"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="-1dp"
        android:background="@drawable/gv_common_popup_notch_up"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/gv_common_popup_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/gv_common_popup_card_bg"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ListView
                android:id="@+id/gv_common_popup_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@color/gv_common_border_light"
                android:dividerHeight="1dp"
                android:maxHeight="@dimen/gv_common_overlapping_popup_max_height"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

            <ImageView
                android:id="@+id/gv_common_popup_chevron"
                android:layout_width="16dp"
                android:layout_height="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/gv_common_ic_chevron_down"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/gv_common_popup_notch_bottom"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="-1dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/gv_common_popup_notch_down" />
</LinearLayout>

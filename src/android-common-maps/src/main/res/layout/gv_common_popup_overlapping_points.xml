<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/gv_common_popup_notch_top"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginBottom="-1dp"
        android:contentDescription="@null"
        android:elevation="1dp"
        android:src="@drawable/gv_common_popup_notch_up" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gv_common_popup_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/gv_common_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/gv_common_border_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ListView
                android:id="@+id/gv_common_popup_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@color/gv_common_border_light"
                android:dividerHeight="1dp"
                android:maxHeight="@dimen/gv_common_overlapping_popup_max_height"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

            <ImageView
                android:id="@+id/gv_common_popup_chevron"
                android:layout_width="16dp"
                android:layout_height="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/gv_common_ic_chevron_down"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/gv_common_popup_notch_bottom"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="-2dp"
        android:contentDescription="@null"
        android:elevation="1dp"
        android:src="@drawable/gv_common_popup_notch_down"
        android:visibility="gone" />
</LinearLayout>

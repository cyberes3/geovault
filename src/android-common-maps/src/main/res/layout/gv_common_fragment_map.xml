<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <org.maplibre.android.maps.MapView
        android:id="@+id/gv_common_mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gv_common_map_underlay"
        app:maplibre_foregroundLoadColor="@color/gv_common_map_underlay"
        android:clickable="true"
        android:focusable="true"
        android:overScrollMode="never" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gv_common_mapToggleCard"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/gv_common_primary_blue">

        <ImageView
            android:id="@+id/gv_common_mapToggle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gv_common_ic_layers"
            android:contentDescription="@string/gv_common_map_toggle_content_description"
            app:tint="@color/gv_common_content_on_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

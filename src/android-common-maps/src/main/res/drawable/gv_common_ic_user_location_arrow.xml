<?xml version="1.0" encoding="utf-8"?>
<!--
  Directional user-location puck foreground (compass mode). The chevron apex sits near the top
  of the 32x32 viewport so that MapLibre's bearing rotation around the drawable's geometric
  center (16, 16) swings the apex outward in the heading direction while the white circle
  background stays pinned over the user's position.

  The group scale is anchored at the apex (pivot 16, 2.6) so the chevron tip hugs the top edge
  of the disc regardless of scale. No stroke: the circle background supplies the outline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:pivotX="16"
        android:pivotY="2.6">
        <path
            android:fillColor="@color/gv_common_main_blue"
            android:pathData="M29.9,28.6 L16.9,2.6 C16.6,1.9 15.5,1.9 15.1,2.6 L2.1,28.6 C1.9,29 2,29.4 2.3,29.7 C2.5,30 3,30.1 3.4,29.9 L16,25.1 L28.6,30 C28.7,30 28.8,30 29,30 C29.3,30 29.5,29.9 29.7,29.7 C30,29.4 30.1,28.9 29.9,28.6 Z" />
    </group>
</vector>

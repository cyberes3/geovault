[Unit]
Description=GeoVault Live Track broadcast flush (batches WebSocket updates)
After=network.target

[Service]
Type=simple
User=geovault
SyslogIdentifier=geovault-live-track-flush
WorkingDirectory=/srv/geovault/geovault/src/backend
ExecStart=/srv/geovault/geovault/src/backend/venv/bin/python manage.py flush_live_track_broadcasts --interval=0.2
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target

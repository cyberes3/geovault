[Unit]
Description=Overpass API Fetch OSC Updates
Documentation=https://dev.overpass-api.de/
After=network.target overpass-dispatcher.service
Requires=overpass-dispatcher.service

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Main execution
ExecStart=/usr/bin/fetch_osc.sh auto https://planet.osm.org/replication/day/ /srv/overpass/replicates

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=90
TimeoutStopSec=300

# Resource protection
OOMScoreAdjust=-500

# Shared memory and IPC configuration
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-fetch

[Install]
WantedBy=multi-user.target

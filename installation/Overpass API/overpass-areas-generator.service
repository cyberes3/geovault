[Unit]
Description=Overpass API Area Generator
Documentation=https://dev.overpass-api.de/
After=network.target
After=overpass-dispatcher.service
After=overpass-areas-dispatcher.service
Requires=overpass-areas-dispatcher.service

[Service]
Type=oneshot
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Generate areas incrementally (delta updates - faster after initial generation)
# Use relative path from WorkingDirectory (/srv/overpass)
ExecStart=/usr/bin/rules_delta_loop.sh databases

# Resource limits - run with lower priority to not impact queries
Nice=19
IOSchedulingClass=idle

# Shared memory and IPC
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-areas-generator

[Install]
WantedBy=multi-user.target

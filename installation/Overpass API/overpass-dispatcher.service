[Unit]
Description=Overpass API Dispatcher Daemon
Documentation=https://dev.overpass-api.de/
After=network.target

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Clean up any leftover socket files before starting
# First try to terminate any running dispatcher instance, then clean up sockets
ExecStartPre=/bin/sh -c '/usr/bin/dispatcher --osm-base --meta --db-dir=/srv/overpass/databases --terminate 2>/dev/null || true; sleep 1; rm -f /srv/overpass/databases/osm3s_osm_base /dev/shm/osm3s_osm_base 2>/dev/null || true'

# Main execution
ExecStart=/usr/bin/dispatcher --osm-base --meta --db-dir=/srv/overpass/databases
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown: use dispatcher's terminate command, then clean up any remaining sockets
ExecStop=/usr/bin/dispatcher --osm-base --meta --db-dir=/srv/overpass/databases --terminate
ExecStopPost=/bin/sh -c 'sleep 1; rm -f /srv/overpass/databases/osm3s_osm_base /dev/shm/osm3s_osm_base 2>/dev/null || true'

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior (following PostgreSQL pattern)
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=0
TimeoutStopSec=300

# Resource protection (following PostgreSQL pattern)
OOMScoreAdjust=-1000

# Shared memory and IPC configuration
# RemoveIPC=no prevents systemd from deleting shared memory when user logs out
# This can be set here (systemd 232+) or globally in /etc/systemd/logind.conf
# PrivateTmp=no is required to allow access to shared memory segments
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-dispatcher

[Install]
WantedBy=multi-user.target

[Unit]
Description=Overpass API Areas Dispatcher Daemon
Documentation=https://dev.overpass-api.de/
After=network.target
After=overpass-dispatcher.service

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Areas dispatcher (separate from base dispatcher)
ExecStart=/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases
ExecReload=/bin/kill -HUP $MAINPID

# Clean up socket files after process exits
# Unix sockets can persist if the process doesn't close them cleanly
# Only remove socket files (type s), NOT lock files (which must not be deleted externally per Overpass API docs)
# Clean up sockets in both database directory and shared memory
ExecStopPost=/bin/sh -c 'sleep 1; find /srv/overpass/databases -maxdepth 1 -name "osm3s_areas*" -type s -delete 2>/dev/null || true; find /dev/shm -maxdepth 1 -name "osm3s_areas*" -type s -delete 2>/dev/null || true'

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=0
TimeoutStopSec=300

# Resource protection
OOMScoreAdjust=-1000

# Shared memory and IPC configuration
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-areas-dispatcher

[Install]
WantedBy=multi-user.target

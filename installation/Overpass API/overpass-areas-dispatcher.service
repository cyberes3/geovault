[Unit]
Description=Overpass API Areas Dispatcher Daemon
Documentation=https://dev.overpass-api.de/
After=network.target
After=overpass-dispatcher.service

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Areas dispatcher (separate from base dispatcher)
ExecStart=/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases
ExecReload=/bin/kill -HUP $MAINPID

# Clean up socket files after process exits
# Unix sockets can persist if the process doesn't close them cleanly
ExecStopPost=/bin/sh -c 'sleep 1; rm -f /srv/overpass/databases/osm3s_areas /dev/shm/osm3s_areas 2>/dev/null || true'

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=0
TimeoutStopSec=300

# Resource protection
OOMScoreAdjust=-1000

# Shared memory and IPC configuration
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-areas-dispatcher

[Install]
WantedBy=multi-user.target

[Unit]
Description=Overpass API Areas Dispatcher Daemon
Documentation=https://dev.overpass-api.de/
After=network.target
After=overpass-dispatcher.service

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Clean up any leftover socket files before starting
# First try to terminate any running dispatcher instance, then clean up sockets
ExecStartPre=/bin/sh -c '/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases --terminate 2>/dev/null || true; sleep 1; rm -f /srv/overpass/databases/osm3s_areas /dev/shm/osm3s_areas 2>/dev/null || true'

# Areas dispatcher (separate from base dispatcher)
ExecStart=/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown: use dispatcher's terminate command, then clean up any remaining sockets
ExecStop=/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases --terminate
ExecStopPost=/bin/sh -c 'sleep 1; rm -f /srv/overpass/databases/osm3s_areas /dev/shm/osm3s_areas 2>/dev/null || true'

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=0
TimeoutStopSec=300

# Resource protection
OOMScoreAdjust=-1000

# Shared memory and IPC configuration
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-areas-dispatcher

[Install]
WantedBy=multi-user.target

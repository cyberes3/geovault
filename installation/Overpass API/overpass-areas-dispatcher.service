[Unit]
Description=Overpass API Areas Dispatcher Daemon
Documentation=https://dev.overpass-api.de/
After=network.target
After=overpass-dispatcher.service

[Service]
Type=simple
User=overpass
Group=overpass
WorkingDirectory=/srv/overpass

# Areas dispatcher (separate from base dispatcher)
ExecStart=/usr/bin/dispatcher --areas --db-dir=/srv/overpass/databases
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10

# Shutdown behavior
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=0
TimeoutStopSec=300

# Resource protection
OOMScoreAdjust=-1000

# Shared memory and IPC configuration
RemoveIPC=no
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overpass-areas-dispatcher

[Install]
WantedBy=multi-user.target

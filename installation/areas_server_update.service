[Unit]
Description=GeoVault Areas Server incremental update
After=network.target postgresql.service

[Service]
Type=oneshot
User=geovault
WorkingDirectory=/srv/geovault/geovault/src/areas_server
EnvironmentFile=-/etc/secrets/areas_server.env
ExecStart=/srv/geovault/geovault/src/areas_server/scripts/update.sh

[Install]
WantedBy=multi-user.target

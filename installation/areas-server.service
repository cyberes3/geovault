[Unit]
Description=GeoVault Areas Server
After=network.target postgresql.service

[Service]
Type=simple
User=geovault
SyslogIdentifier=areas-server
WorkingDirectory=/srv/geovault/geovault/src/areas_server
EnvironmentFile=-/etc/secrets/areas_server.env
ExecStart=/srv/geovault/geovault/src/areas_server/venv/bin/gunicorn -w 4 -b 0.0.0.0:5001 app:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target

[Unit]
Description=GeoVault Areas Server incremental update
After=network.target postgresql.service

[Service]
Type=oneshot
User=geovault
SyslogIdentifier=areas-server-update
WorkingDirectory=/srv/geovault/geovault/src/areas_server
EnvironmentFile=-/etc/secrets/areas_server.env
ExecStart=/bin/bash -c 'exec /srv/geovault/geovault/src/areas_server/scripts/update.sh --database "$AREAS_SERVER_DATABASE" update'

[Install]
WantedBy=multi-user.target
